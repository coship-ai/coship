---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'CoShip — Your Agentic Co-Founder',
  description = 'Stop building alone. CoShip is the agentic co-founder that plans, builds, and evolves your product with you — and helps you understand every decision. Production-grade software for a fraction of what agencies charge.'
} = Astro.props;

const siteUrl = 'https://coship.dev';
const ogImage = `${siteUrl}/og-image.svg`;

// JSON-LD structured data
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "CoShip",
  "description": "Your agentic co-founder — production-grade software, strategic guidance, and technical education for non-technical founders",
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "macOS",
  "offers": [
    {
      "@type": "Offer",
      "name": "Lifetime Licence",
      "price": "749",
      "priceCurrency": "USD"
    },
    {
      "@type": "Offer",
      "name": "Monthly (per project)",
      "price": "249",
      "priceCurrency": "USD"
    },
    {
      "@type": "Offer",
      "name": "Annual (unlimited projects)",
      "price": "1249",
      "priceCurrency": "USD"
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0c4a6e" />
    <meta name="author" content="CoShip" />

    <!-- Canonical URL -->
    <link rel="canonical" href={siteUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:site_name" content="CoShip" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/svg+xml" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:site" content="@coship_ai" />
    <meta name="twitter:creator" content="@coship_ai" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Global currency source of truth -->
    <script is:inline>
      window.coshipCurrencies = {
        USD: { symbol: '$', lifetime: 749, monthly: 249, annual: 1249 },
        GBP: { symbol: '\u00a3', lifetime: 599, monthly: 199, annual: 999 },
        EUR: { symbol: '\u20ac', lifetime: 699, monthly: 229, annual: 1149 }
      };
      (function() {
        var locale = navigator.language.toLowerCase();
        var euroCountries = ['de','fr','es','it','nl','be','at','ie','pt','fi','gr','lu','mt','sk','si','ee','lv','lt','cy'];
        if (locale.includes('gb') || locale === 'en-gb') {
          window.coshipCurrentCurrency = 'GBP';
        } else if (euroCountries.some(function(c) { return locale.includes(c); })) {
          window.coshipCurrentCurrency = 'EUR';
        } else {
          window.coshipCurrentCurrency = 'USD';
        }
      })();
    </script>

    <title>{title}</title>
  </head>
  <body class="antialiased">
    <slot />
  </body>
</html>

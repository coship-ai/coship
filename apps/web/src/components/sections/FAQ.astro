---
import Container from '../ui/Container.astro';

interface FAQItem {
  question: string;
  answer: string;
}

const faqs: FAQItem[] = [
  {
    question: 'Why not hire a co-founder, fractional CTO, or agency?',
    answer: 'A technical co-founder takes months to find and costs 10-50% equity. Agencies and contractors charge <span data-faq-price="agency-range"></span> per month, take weeks to onboard, and hand you code you don\'t understand. Fractional CTOs give you 10-20 hours a week at best. Every option is either slow, expensive, or leaves you dependent. CoShip delivers production-grade output at a fraction of the cost—and because Ship explains every decision, you walk away with the technical knowledge to own your product completely.'
  },
  {
    question: 'How is this different from using Claude directly?',
    answer: 'Using Claude directly is like hiring a brilliant consultant who has amnesia between meetings. Ship is a configured co-founder with deep context about your product, your architecture, and your working style. It challenges your ideas, maintains continuity across sessions, and educates you on every technical decision. It\'s the difference between a general-purpose tool and a dedicated technical co-founder who knows your business inside out.'
  },
  {
    question: 'What are CoShip templates?',
    answer: 'Production blueprints that agencies and contractors charge thousands to create. Each template is a pre-configured architecture pattern for a specific product type—SaaS platforms, mobile apps, marketplaces, and more. They include folder structures, security configurations, and best practices optimised for that product type. Ship uses them to give your project an enterprise-grade foundation from the very first line of code.'
  },
  {
    question: 'Do I need coding experience?',
    answer: 'None. Ship is built for non-technical founders. But here\'s what makes CoShip different from other no-code or AI tools: you won\'t stay non-technical. Ship explains every architectural decision, every trade-off, and every technical concept as you build together. By the time your product launches, you\'ll have genuine technical literacy—enough to evaluate developers, speak to investors with confidence, and make informed decisions about your own product.'
  },
  {
    question: 'How are skills delivered?',
    answer: 'CoShip skills are delivered as cloud-connected tools that live online — always current, always improving. When we release new capabilities or enhance existing ones, you get access automatically. No downloads, no manual updates, no version management. Connect Claude to CoShip and you\'re building with the latest tools immediately.'
  },
  {
    question: 'What\'s the Autonomous tier?',
    answer: 'AutoShip is our upcoming tier where Ship works independently. Instead of you driving each session, Ship executes tasks autonomously—learning from your feedback, shipping features, and providing daily progress reports. Think of CoShip as "building with an expert co-founder" and AutoShip as "delegating to a capable technical team." Coming soon.'
  },
  {
    question: 'Can I use this for multiple projects?',
    answer: 'Absolutely. Lifetime licence holders get unlimited projects forever. Annual subscribers also get unlimited projects. Monthly plans are licensed per project at <span data-faq-price="monthly"></span>/mo. Each project gets its own Ship personality, context, and architecture—so you can run multiple products simultaneously without any bleed between them.'
  },
  {
    question: 'What\'s included in CoShip?',
    answer: 'Full access to a growing library of co-founder-grade skills: production architecture templates, workflow automation, security auditing, one-click deployment, and personality configuration. Every skill includes founder education—Ship doesn\'t just do the work, it teaches you why it\'s done that way. Lifetime holders get every current and future skill update forever.'
  }
];

// FAQPage structured data for rich search results
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section id="faq" class="py-24 md:py-32 bg-dark-900">
  <Container size="md">
    <!-- Section header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="font-display font-bold text-3xl sm:text-4xl md:text-5xl text-ocean-50 mb-6">
        Frequently Asked Questions
      </h2>
      <p class="text-lg text-ocean-300">
        Everything you need to know before you start building.
      </p>
    </div>

    <!-- FAQ accordion -->
    <div class="space-y-4">
      {faqs.map((faq, index) => (
        <div class="faq-item border border-ocean-500/20 rounded-xl overflow-hidden bg-dark-900 hover:border-ocean-500/30 transition-colors">
          <button
            class="faq-trigger w-full flex items-center justify-between p-6 text-left"
            aria-expanded="false"
            data-index={index}
          >
            <span class="font-display font-semibold text-lg text-ocean-50 pr-4">{faq.question}</span>
            <span class="faq-icon flex-shrink-0 w-6 h-6 text-ocean-400 transition-transform duration-300">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </button>
          <div class="faq-content hidden">
            <div class="px-6 pb-6 text-ocean-300 leading-relaxed" set:html={faq.answer}>
            </div>
          </div>
        </div>
      ))}
    </div>
  </Container>
</section>

<script>
  // Populate FAQ price spans from global currency data
  function updateFaqPrices() {
    const currencies = (window as any).coshipCurrencies;
    const current = (window as any).coshipCurrentCurrency || 'USD';
    if (!currencies) return;
    const c = currencies[current];

    document.querySelectorAll('[data-faq-price]').forEach(el => {
      const key = el.getAttribute('data-faq-price');
      if (key === 'monthly') {
        el.textContent = `${c.symbol}${c.monthly}`;
      } else if (key === 'agency-range') {
        el.textContent = `${c.symbol}3,000–${c.symbol}10,000+`;
      }
    });
  }

  updateFaqPrices();
  window.addEventListener('coship:currency-change', updateFaqPrices);

  document.querySelectorAll('.faq-trigger').forEach(trigger => {
    trigger.addEventListener('click', () => {
      const item = trigger.closest('.faq-item');
      const content = item?.querySelector('.faq-content');
      const icon = trigger.querySelector('.faq-icon');
      const isExpanded = trigger.getAttribute('aria-expanded') === 'true';

      // Close all other items
      document.querySelectorAll('.faq-item').forEach(otherItem => {
        if (otherItem !== item) {
          const otherTrigger = otherItem.querySelector('.faq-trigger');
          const otherContent = otherItem.querySelector('.faq-content');
          const otherIcon = otherItem.querySelector('.faq-icon');
          otherTrigger?.setAttribute('aria-expanded', 'false');
          otherContent?.classList.add('hidden');
          otherIcon?.classList.remove('rotate-180');
        }
      });

      // Toggle current item
      trigger.setAttribute('aria-expanded', String(!isExpanded));
      content?.classList.toggle('hidden');
      icon?.classList.toggle('rotate-180');
    });
  });
</script>

<style>
  .faq-icon {
    transition: transform 0.3s ease;
  }

  .faq-icon.rotate-180 {
    transform: rotate(180deg);
  }
</style>
